# Copy to .env and fill in. Never commit .env.
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# Host names or IPs you use to reach the app, comma separated.
# localhost and 127.0.0.1 are always allowed.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (scheme://host:port) you use in the browser, comma separated.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Set to true only if the app is served over HTTPS.
DJANGO_SECURE_COOKIES=false
TIME_ZONE=UTC
LOG_LEVEL=INFO

# Behind a reverse proxy that terminates HTTPS (all optional, off by default).
# Trust X-Forwarded-Proto only if the proxy always sets it.
# TRUST_X_FORWARDED_PROTO=true
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false

# Database. Docker Compose uses these for both the postgres and web containers.
POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change-me
# Only needed outside Docker Compose (local development); Compose sets POSTGRES_HOST=db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Where uploaded CVs and cover letters are stored. Compose sets this to the documents volume.
# PRIVATE_MEDIA_ROOT=./private-media
DOCUMENT_MAX_UPLOAD_MB=15
# Days without activity before an application waiting on the employer is flagged.
STALE_AFTER_DAYS=14
# Sources suggested in the application form, comma separated. Sources you have
# already used are always offered too. Set it empty to suggest none.
# SOURCE_SUGGESTIONS=LinkedIn,Company website,Referral,Recruiter,Jobindex
# Only for the upgrade that introduced separate accounts, if more than one account
# exists by then: the username that gets the existing data. See README.md.
# EXISTING_DATA_OWNER=

# Optional weekly summary e-mail (manage.py send_weekly_summary). Leave EMAIL_HOST empty to turn it off.
EMAIL_HOST=
# Defaults to 587 (STARTTLS); set EMAIL_USE_SSL=true for port 465.
# EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=jobseekr@example.com
# Each account's summary goes to the e-mail address on that account (set it in the admin).
# The address you open the app on, so the e-mail can link back to it.
# SITE_URL=http://localhost:8000

# Public demo (see "Public demo mode" in README.md). Leave DEMO_MODE off for your own tracker.
# DEMO_MODE=false
# CAPTURE_MODE=live                # "samples" fetches nothing; the demo requires it
# DOCUMENT_UPLOADS_ENABLED=true    # the demo requires false
# SANDBOX_LIFETIME_HOURS=24
# SANDBOX_MAX_ACTIVE=100
# SANDBOX_RATE_LIMIT=3
# SANDBOX_RATE_WINDOW=3600
# SANDBOX_MAX_APPLICATIONS=200
# SANDBOX_MAX_COMPANIES=100
# CLIENT_IP_HEADER=CF-Connecting-IP   # only behind a proxy that always sets it
# DEMO_LOG_RETENTION_DAYS=14
# SCHEDULER_INTERVAL_SECONDS=300
# A site to link back to from a strip on top of every page; empty shows none.
# MAIN_SITE_URL=

# Docker Compose only: the host address and port the web container is published on.
# 127.0.0.1 makes the app reachable from this machine only. To reach it from your
# network, set the server's own LAN address here, for example 192.0.2.10 (never 0.0.0.0).
# To also publish on a Tailscale address, see docs/deploy-home-server.md.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
# TAILSCALE_ADDRESS=100.x.y.z   # only read by the optional relay override (deploy/compose.override.example.yaml)

# Docker Compose only: keep the project (and so the volume) name of an existing
# stack. Not needed on a fresh install. See "Upgrading" in README.md.
# COMPOSE_PROJECT_NAME=job-tracker
