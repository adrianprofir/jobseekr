# Copy to .env next to compose.yml and fill in. Never commit .env. See docs/demo.md.
# Generate the secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

# The public hostname the demo is served on, without a scheme.
DEMO_HOSTNAME=jobseekr-demo.example.com
# The external Docker network the proxy or tunnel shares with the demo (create it once),
# and the name the proxy uses to reach the demo on it. Keep the alias unique on that
# network, and never use a bare name such as web.
DEMO_EDGE_NETWORK=showcase-jobseekr-edge
DEMO_EDGE_ALIAS=showcase-jobseekr-web
# Smoke tests from the host use this loopback-only port.
DEMO_SMOKE_PORT=8095

# The demo settings. Leave them as they are: the app refuses to start with DEMO_MODE on
# and CAPTURE_MODE=live or uploads enabled. This demo sends no mail, so there are no mail
# settings, and there must never be any.
DEMO_MODE=true
CAPTURE_MODE=samples
DOCUMENT_UPLOADS_ENABLED=false

# The request header that carries the visitor's address, for the sandbox rate limit.
# Only correct behind a proxy that always sets it; Cloudflare sets CF-Connecting-IP.
CLIENT_IP_HEADER=CF-Connecting-IP

# A site to link back to from a strip on top of every page; empty shows none.
# MAIN_SITE_URL=https://www.example.com

# Lower SECURE_HSTS_SECONDS while testing, because browsers remember it.
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=3600
# TIME_ZONE=UTC
# SANDBOX_LIFETIME_HOURS=24
# SANDBOX_MAX_ACTIVE=100
# SANDBOX_RATE_LIMIT=3
# SANDBOX_RATE_WINDOW=3600
# DEMO_LOG_RETENTION_DAYS=14
# SCHEDULER_INTERVAL_SECONDS=300
